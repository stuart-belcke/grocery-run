{
  "name": "grocery-run",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.js\"",
    "lint": "eslint .",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:rules": "node --test --test-concurrency=1 tests/rules/rules.test.mjs tests/rules/sweep.test.mjs",
    "check": "npm run lint && npm test && npm run test:rules && npm run test:e2e && npm run build",
    "emulator:fetch": "firebase setup:emulators:database"
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.26.0",
    "globals": "^17.9.0",
    "playwright-core": "^1.56.1",
    "vite": "^5.4.11"
  }
}
