node_modules/
# Any build output: `dist/` from `npm run build`, plus the ad-hoc
# `dist-<something>/` a person makes while checking one build by hand.
# One of those was committed once and sat in the repo for a week.
dist*/

# The database emulator writes this next to wherever it is started from.
database-debug.log
firebase-debug.log

# Service-account keys for scripts/reclaim-households.mjs. A key is a
# password to the whole database — it must never be committed.
scripts/keys/
*.serviceaccount.json
