{
  // Firebase's rules parser accepts these // comments even though this file
  // is otherwise plain JSON — the console's Rules tab and `firebase deploy`
  // both strip them before evaluating. Nothing in this repo's own build or
  // tests parses this file, so that's safe.
  "rules": {
    // No ".read" / ".write" is set here, and RTDB denies by default wherever
    // nothing grants access — so /households itself (and therefore every
    // household's data at once) can never be read or listed. Only the
    // specific $code branch below is ever granted anything.
    "households": {
      "$code": {
        // Item 37, CONTRACT. Access now requires a real identity AND a
        // membership record — the code alone is no longer sufficient, and
        // there is deliberately no unauthenticated fallback. A device that
        // isn't signed in reads and writes NOTHING here; it still opens and
        // works entirely from its localStorage cache, and the app says so
        // rather than showing a green "Synced" dot over a dead connection.
        //
        // This is the step that closes the gap the whole sequence exists
        // for: before it, anyone who had ever seen the code had permanent
        // access with no way to tell who they were or to take it away.
        //
        // Knowing the code is NO LONGER ENOUGH TO JOIN. An account becomes
        // a member one of three ways, all under "members" below: it claims
        // an unclaimed household, it redeems an unexpired invite created by
        // an existing member, or it already had a record. That is what makes
        // removal actually stick — a removed account still knows the code,
        // and now the code buys it nothing.
        ".read": "auth != null && root.child('households').child($code).child('members').child(auth.uid).exists()",
        ".write": "auth != null && root.child('households').child($code).child('members').child(auth.uid).exists()",

        // Runs on every write to this branch or anything below it. $code is
        // the household code itself (the wildcard segment's value) — this
        // requires it to be 8-40 lowercase letters/digits/hyphens, matching
        // the exact alphabet cleanCode() in src/sync.js already restricts a
        // code to client-side. The floor of 8 exists so a short, easily
        // guessed code can never be written in the first place; a real
        // generated code (loadDeviceCode()) is 13 characters, well clear of
        // it. Doesn't gate READS — a guessed or malformed code just resolves
        // to nothing, which is harmless.
        ".validate": "$code.matches(/^[a-z0-9-]{8,40}$/)",

        // The shopping list, week plan and staples. Deliberately NOT a full
        // schema — normalizeLocal (lib.js) spreads unrecognised fields
        // through untouched on purpose, so an older build can still write a
        // household a newer build already extended. A strict schema here
        // would silently defeat that same forward-compatibility guarantee
        // from underneath the app. Only checked: updatedAt, present on every
        // single write (setLocal stamps it), must actually be a number — the
        // one thing a malformed payload (item 20's whole reason for
        // existing) would most obviously get wrong.
        "state": {
          "updatedAt": {
            ".validate": "newData.isNumber()"
          }
        },
        // Recipes, ingredients and stores. Same reasoning and same
        // shallowness as "state" above — just the two stamps every catalog
        // write always carries.
        "catalog": {
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "appDataVersion": {
            ".validate": "newData.isNumber()"
          }
        },

        // Item 37. THE ONLY DOOR INTO A HOUSEHOLD. This needs its own
        // ".write" because the $code-level one above requires membership,
        // and the account that needs this write is precisely the one that
        // isn't a member yet — without a deeper grant, joining would be
        // impossible by construction. A deeper ".write" grants where a
        // shallower one denied, so everything that decides who may join is
        // concentrated in this one expression, on purpose.
        //
        // Four cases, and nothing else is permitted:
        //   1. data.exists() — I already have a record here. Covers both
        //      refreshing it on every load and deleting it to leave.
        //   2. the household has NO members at all — first claim. A brand
        //      new code has to become somebody's somehow, and every real
        //      household already has members, so this can't be turned on an
        //      occupied one. (A household whose last member leaves becomes
        //      claimable again. That is abandonment, not a back door.)
        //   3. an unexpired invite, presented as `invite` in the record
        //      being written. `now` is server time, so a device with a wrong
        //      clock can't extend its own window. isString() guards the
        //      lookup: child(null) on a missing field is not a valid path.
        //   4. a deletion by an existing member — removing somebody else.
        //      Deletion only; a member can never CREATE or edit another
        //      account's record, which is what keeps a member record honest
        //      about who wrote it.
        //
        // Cases 1-3 all require auth.uid == $uid, so no account can ever
        // forge a record for another. Case 4 is the sole exception and is
        // limited to taking one away.
        "members": {
          "$uid": {
            ".write": "auth != null && ((auth.uid == $uid && (data.exists() || !root.child('households').child($code).child('members').exists() || (newData.child('invite').isString() && root.child('households').child($code).child('invites').child(newData.child('invite').val()).child('exp').val() > now))) || (!newData.exists() && root.child('households').child($code).child('members').child(auth.uid).exists()))",
            ".validate": "auth != null && auth.uid == $uid && newData.hasChild('updatedAt')"
          }
        },

        // Item 37. Invites. Only a member can create or revoke one, so the
        // right to let somebody in belongs to the people already in.
        // Redemption does NOT delete the invite here — the redeemer isn't a
        // member at the moment they redeem, and opening deletion to
        // non-members would let anyone holding the code burn every
        // outstanding invite. The app deletes it immediately AFTER joining,
        // by which point it IS a member and this rule allows it; if that
        // second write is lost the invite simply expires on its own.
        "invites": {
          ".read": "auth != null && root.child('households').child($code).child('members').child(auth.uid).exists()",
          "$token": {
            ".write": "auth != null && root.child('households').child($code).child('members').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['by', 'exp']) && newData.child('exp').isNumber() && newData.child('by').val() == auth.uid"
          }
        }
      }
    },

    // Item 37, first half: a signed-in identity, purely additive alongside
    // everything above — this grants nothing extra under "households", and
    // nothing under "households" grants anything here. A signed-in user can
    // read and write ONLY their own record, checked against their real
    // Firebase Auth identity (auth.uid) rather than a string anyone could
    // type — the first rule in this file that can actually verify WHO is
    // asking, not just whether they know a secret.
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        // Same shallow-validate style as the households rules above: catch
        // an obviously malformed write (writeUserRecord always sends a real
        // timestamp) without constraining the rest of the node, so a future
        // field can still be added here without a rules change first.
        "updatedAt": {
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}
